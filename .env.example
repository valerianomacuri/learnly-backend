APP_NAME=API
ENVIRONMENT=development
LOG_LEVEL=INFO
DB_ECHO=false

# Used by docker compose to create the database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_support
POSTGRES_PORT=5432

# Must use the psycopg driver: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_support
# Optional: database used by DB-backed tests (defaults to DATABASE_URL + "_test")
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_support_test

# Authentication: HS256 secret used to sign the JWTs issued by POST /auth/login
# (claims: sub = user id, iat, exp). At least 16 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=7xKp9mQ2vL8nR4wT6yH3jF5aB1cD0eZ9sW2uG6iN8oP4
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60      # lifetime of the tokens issued by /auth/login
