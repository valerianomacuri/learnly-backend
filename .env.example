APP_NAME=API
ENVIRONMENT=development
LOG_LEVEL=INFO
DB_ECHO=false

# Used by docker compose to create the database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_support
POSTGRES_PORT=5432

# Must use the psycopg driver: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_support
# Optional: database used by DB-backed tests (defaults to DATABASE_URL + "_test")
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_support_test

# Authentication: HS256 secret used to sign the JWTs issued by POST /auth/login
# (claims: sub = user id, iat, exp). At least 16 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=7xKp9mQ2vL8nR4wT6yH3jF5aB1cD0eZ9sW2uG6iN8oP4
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60      # lifetime of the tokens issued by /auth/login

# Payout worker (spec 05)
FAIL_RATE=0                      # simulated gateway: probability (0..1) of a transient failure
PAYOUT_MAX_ATTEMPTS=3
PAYOUT_BACKOFF_BASE_SECONDS=30   # retry delay = base * 2^(attempt - 1)
PAYOUT_POLL_SECONDS=2
CORS_ORIGINS=http://localhost:5173   # comma-separated browser origins allowed by CORS

# RAG (spec 07). Without OPENAI_API_KEY the refund flow still works (no LLM needed).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini
RELEVANCE_THRESHOLD=0.25
RERANK_MODEL=BAAI/bge-reranker-base

# Agent LLM client (spec 09)
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Security & resilience (spec 12). Without REDIS_URL: reads fail open, writes (chat, POST /refunds) fail closed.
REDIS_URL=redis://localhost:6379/0
CHAT_RATE_LIMIT=20               # messages per window per customer
CHAT_RATE_WINDOW_S=60
REFUND_RATE_LIMIT=5              # POST /refunds per window per customer
REFUND_RATE_WINDOW_S=3600
THREAD_TOKEN_BUDGET=50000        # LLM tokens per chat thread
LLM_FALLBACK_MODEL=              # OpenAI model used when the primary fails (optional)
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_S=30
